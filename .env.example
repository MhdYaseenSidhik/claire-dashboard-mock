# Claire dashboard — example environment. Copy to .env for local dev.
# The dashboard reads the analysis/forecast output produced by the cell;
# these point at where that data comes from. No secrets belong in git.

# Base path the app is served under (default "/").
VITE_BASE_PATH=/

# Where the built dashboard reads its data bundle from (KPIs, forecasts,
# alerts, PR recommendations produced by the analysis pipeline).
# Default is a bundled static JSON; override to fetch from an API.
VITE_DATA_URL=/data/analysis.json

# Forecasting MCP endpoint, if the app calls it at runtime rather than
# consuming a precomputed bundle. Left blank in the mock.
VITE_FORECAST_MCP_URL=
