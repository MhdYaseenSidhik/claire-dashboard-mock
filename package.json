{
  "name": "claire-dashboard-mock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Claire inventory & forecasting dashboard — mock for the Inventory & Forecasting Cell",
  "scripts": {
    "dev": "vite",
    "build:data": "tsx scripts/build_analysis.mts",
    "build": "npm run build:data && tsc -b && vite build",
